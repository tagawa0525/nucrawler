	<item>
		<title>加カメコ　GLEと独占的オフテイク契約を締結</title>
		<link>https://www.jaif.or.jp/journal/oversea/35993.html</link>
		
		<dc:creator><![CDATA[SakuraiHisako]]></dc:creator>
		<pubDate>Fri, 25 Sep 2026 08:14:12 +0000</pubDate>
				<category><![CDATA[海外NEWS]]></category>
		<category><![CDATA[DUF6]]></category>
		<category><![CDATA[GLE]]></category>
		<category><![CDATA[PGDP]]></category>
		<category><![CDATA[PLEF]]></category>
